# ==============================================================================
# RestaurantOS Local Hub Environment Configuration (.env.example)
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Custom Data Directory Override (Defaults to %ProgramData%\RestaurantOS on Windows)
# RESTAURANTOS_DATA_DIR=C:\ProgramData\RestaurantOS

# Database File Path Override (Defaults to <RESTAURANTOS_DATA_DIR>\restaurantos.db)
# RESTAURANTOS_DB_PATH=C:\ProgramData\RestaurantOS\restaurantos.db

# Host Binding (0.0.0.0 binds to all LAN interfaces for POS/Kitchen terminal connections)
HOST=0.0.0.0
